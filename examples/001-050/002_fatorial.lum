/// 002 — Fatorial recursivo com `Result`.
///
/// Mostra `if/else`, recursão e propagação de erro com `?`.
/// `math::fat` faz o mesmo na stdlib.

use std::io;

/// Fatorial de `n`. Retorna `Err` se `n < 0`.
fn fat(n: i32) -> Result<i32, str> {
    if n < 0 {
        return Err("n negativo");
    }
    if n <= 1 {
        return Ok(1);
    }
    let sub = fat(n - 1)?;
    return Ok(n * sub);
}

/// Ponto de entrada do programa.
fn main() {
    match fat(5) {
        Ok(v) => println("5! = " + str::from_int(v)),
        Err(e) => println("erro: " + e),
    }
}

#[test]
fn testa_fat() {
    assert_eq(fat(5), Ok(120));
    assert_eq(fat(0), Ok(1));
}
