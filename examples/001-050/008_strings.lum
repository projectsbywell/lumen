/// 008 — Strings UTF-8.
///
/// `str` é UTF-8 imutável; `str::len` conta caracteres (não bytes).
/// `+` concatena `str + str`.

use std::str;

/// Normaliza um nome: tira espaços e padroniza maiúsculas.
fn normaliza(nome: str) -> String {
    return str::upper(str::trim(nome));
}

/// Ponto de entrada do programa.
fn main() {
    let s = "  olá, Lumen  ";
    println("'" + normaliza(s) + "'");
    println("chars = " + str::from_int(str::len("olá")));

    let csv = "ana,bia,cid";
    let partes = str::split(csv, ",");
    println(str::join(partes, " | "));
    println(str::lower("LUMEN É LEGAL"));
}

#[test]
fn testa_normaliza() {
    assert_eq(normaliza("  ana "), "ANA");
}
